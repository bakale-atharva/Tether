      "description": "Shared medium danger variant.",
      "html": "<button class=\"ds-button-danger\" type=\"button\">Delete</button>",
      "css": ".ds-button-danger{font-family:var(--font-body);font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:9999px;cursor:pointer;transition:background-color 150ms,color 150ms;background:var(--danger);color:var(--danger-fg);border:0;}.ds-button-danger:hover{background:color-mix(in oklab,var(--danger) 90%,transparent);}.ds-button-danger:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button-danger:disabled{cursor:not-allowed;background:var(--surface-2);color:var(--muted);}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Wrapper owns field focus; the input has no duplicate ring.",
      "html": "<label class=\"ds-field\">Display name<span class=\"ds-field-wrap\"><input aria-label=\"Display name\" placeholder=\"Display name\"></span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:600 14px/20px var(--font-body);color:var(--ink)}.ds-field-wrap{display:flex;height:48px;border:1px solid transparent;border-radius:9999px;background:var(--surface-2);transition:border-color 150ms}.ds-field-wrap:focus-within{outline:2px solid var(--ring);outline-offset:2px;}.ds-field input{min-width:0;width:100%;padding:0 16px;border:0;border-radius:9999px;background:transparent;color:var(--ink);font:400 16px/24px var(--font-body);outline:none}.ds-field input::placeholder{color:var(--muted)}.ds-field input:disabled{cursor:not-allowed;color:var(--muted)} .ds-field-wrap:has(input[aria-invalid=\"true\"]){background:var(--danger-soft)}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Desktop active item; icons are inline SVG.",
      "html": "<nav aria-label=\"Sample primary\"><a class=\"ds-nav\" href=\"#\" aria-current=\"page\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1Z\"/></svg><span>Home</span></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 12px;border-radius:9999px;background:var(--surface-2);color:var(--ink);font:600 16px/24px var(--font-body);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav:hover{background:var(--surface-2)}.ds-nav:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Plan Badge",
      "kind": "chip",
      "refersTo": "plan-badge",
      "description": "Real plan status link, mobile target and denser desktop size.",
      "html": "<a class=\"ds-badge\" href=\"#\">Free</a>",
      "css": ".ds-badge{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;border:1px solid transparent;background:var(--surface-2);border-radius:9999px;color:var(--ink);font:600 12px/16px var(--font-body);text-decoration:none;transition:background-color 150ms}.ds-badge:hover{background:color-mix(in oklab,var(--surface-2) 70%,transparent)}.ds-badge:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}@media(min-width:768px){.ds-badge{min-height:28px;padding:0 10px}}"
    },
    {
      "name": "Pricing Card and Action",
      "kind": "card",
      "description": "Source-derived Clerk card and footer button; CSS-object states are expanded here.",
      "html": "<section class=\"ds-pricing\"><button type=\"button\" class=\"ds-pricing-action\">Choose plan</button></section>",
      "css": ".ds-pricing{min-width:0;border:1px solid transparent;border-radius:20px;background:var(--clerk-color-muted);box-shadow:none;font-family:var(--font-body)}.ds-pricing-action{min-height:44px;padding:0 20px;border:1px solid transparent;border-radius:9999px;background:var(--clerk-color-primary);background-image:none;color:var(--clerk-color-primary-foreground);box-shadow:none;font:600 14px/20px var(--font-body)}.ds-pricing-action:hover:not(:disabled):not([aria-disabled=\"true\"]),.ds-pricing-action:active:not(:disabled):not([aria-disabled=\"true\"]){background:var(--clerk-color-primary-hover);color:var(--clerk-color-primary-foreground)}.ds-pricing-action:focus-visible{background:var(--clerk-color-primary-hover);outline:2px solid var(--clerk-color-ring);outline-offset:2px;box-shadow:none;}.ds-pricing-action:disabled,.ds-pricing-action[aria-disabled=\"true\"]{background:var(--clerk-color-muted);color:var(--clerk-color-muted-foreground);border-color:transparent;opacity:1}"
    },
    {
      "name": "Auth Field and Social Action",
      "kind": "input",
      "description": "Clerk appearance overrides, with transparent idle borders and single focus treatment.",
      "html": "<div class=\"ds-auth\"><input class=\"ds-auth-input\" aria-label=\"Email\" placeholder=\"Email\"><button class=\"ds-auth-social\" type=\"button\">Continue with provider</button></div>",
      "css": ".ds-auth{display:grid;gap:16px}.ds-auth-input,.ds-auth-social{min-height:44px;border:1px solid transparent;border-radius:9999px;background:var(--clerk-color-muted);box-shadow:none;font-family:var(--font-body)}.ds-auth-input{min-width:0;padding:0 16px;color:var(--clerk-color-input-foreground)}.ds-auth-input:focus,.ds-auth-input:focus-visible{border-color:transparent;outline:2px solid var(--clerk-color-ring);outline-offset:2px;box-shadow:none;}.ds-auth-input[aria-invalid=\"true\"]{background:var(--danger-soft)}.ds-auth-social{padding:0 20px;color:var(--clerk-color-foreground)}.ds-auth-social:hover:not(:disabled):not([aria-disabled=\"true\"]){background:var(--clerk-color-background)}.ds-auth-social:focus-visible{outline:2px solid var(--clerk-color-ring);outline-offset:2px;box-shadow:none;}.ds-auth-input:disabled,.ds-auth-input[aria-disabled=\"true\"],.ds-auth-social:disabled,.ds-auth-social[aria-disabled=\"true\"]{background:var(--clerk-color-muted);color:var(--clerk-color-muted-foreground);opacity:1}"
    },
    {
      "name": "Draft Upload Row",
      "kind": "custom",
      "description": "80px thumbnail silhouette and editable description/removal controls; silhouette stands in for an actual local upload.",
      "html": "<div class=\"ds-upload\"><span class=\"ds-upload-thumbnail\" aria-hidden=\"true\"></span><div class=\"ds-upload-details\"><div class=\"ds-upload-heading\"><label for=\"ds-upload-alt\">Image description</label><button type=\"button\">Remove</button></div><input id=\"ds-upload-alt\" placeholder=\"Describe this image (optional)\"></div></div>",
      "css": ".ds-upload{display:grid;min-width:0;grid-template-columns:80px minmax(0,1fr);align-items:center;gap:12px;font-family:var(--font-body)}.ds-upload-thumbnail{width:80px;height:80px;border-radius:12px;background:var(--surface-2)}.ds-upload-details{min-width:0}.ds-upload-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}.ds-upload label{font-size:12px;font-weight:500;color:var(--muted)}.ds-upload button{min-height:44px;flex-shrink:0;padding:0 8px;border:0;border-radius:9999px;background:transparent;color:var(--danger);font:500 12px/16px var(--font-body);transition:background-color 150ms}.ds-upload button:hover{background:var(--danger-soft)}.ds-upload button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-upload input{display:block;min-height:44px;width:100%;min-width:0;border:0;border-radius:12px;background:var(--surface-2);padding:0 12px;color:var(--ink);font:400 14px/20px var(--font-body);outline:none}.ds-upload input::placeholder{color:var(--muted)}.ds-upload input:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Floating charcoal panels",
    "overview": "Familiar social conversations inside spacious floating panels. The near-black sculpted canvas and graduated opaque charcoal support ordinary reading and sharing; the light theme translates that material into cool gray and porcelain.\n\nSoftly highlighted edges, circular portraits, white primary pills in dark mode and restrained blue links establish the approved world. Use the existing content and states, with spacious imagery when a user supplies it. The system sans is an explicit owner-approved choice for this reference-led interface.",
    "keyCharacteristics": [
      "Opaque graduated panels over a static CSS sculpted backdrop.",
      "Neutral charcoal and porcelain materials; blue for links and focus.",
      "Broad outer corners, pill controls, circular avatars and quiet separators.",
      "Three desktop panels that simplify to an icon rail and then mobile tabs."
    ],
    "rules": [
      {
        "name": "Opaque Material",
        "body": "Panels must remain readable on their opaque base; the backdrop is independent artwork, and blur is not required.",
        "section": "elevation"
      },
      {
        "name": "Neutral Action",
        "body": "Use the neutral accent pair for primary actions and the blue accent-text role for links, selection and focus.",
        "section": "colors"
      },
      {
        "name": "One Family",
        "body": "Keep headings, body copy and controls on the approved system sans stack; distinguish hierarchy through size, weight and spacing.",
        "section": "typography"
      },
      {
        "name": "Quiet Rest",
        "body": "Keep resting control borders transparent, use tonal backgrounds for grouping, and show one outline at the focused control or its wrapper.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the semantic CSS variables so saved and system theme preferences stay coherent.",
      "Do preserve the detached shell geometry, quiet separators and opaque panel bases.",
      "Do keep visible focus, readable disabled states, safe-area padding and mobile touch targets.",
      "Do use actual uploaded imagery or the existing initials/gradient fallback; retain supplied image alt text.",
      "Do retain the collision-safe Clerk aliases and CSS-object pricing/auth state overrides.",
      "Do keep resting control borders transparent and use one focus outline.",
      "Do keep upload previews in compact 80px thumbnail rows with reachable descriptions and removal actions."
    ],
    "donts": [
      "Don't replace the static backdrop with animation or introduce blur-dependent readability.",
      "Don't add invented engagement, recommendations, verification or profile tabs to fill space.",
      "Don't restore idle outline boxes around fields, plan badges or pricing cards.",
      "Don't multiply opaque cards inside the continuous feed panel or introduce hard offset shadows.",
      "Don't treat QA screenshots as runtime image assets or add reference photography as real account content."
    ]
  }
}
