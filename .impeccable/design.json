      "css": ".ds-button-danger{font-family:var(--font-body);font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:9999px;cursor:pointer;transition:background-color 150ms,color 150ms;background:var(--danger);color:var(--danger-fg);border:0;}.ds-button-danger:hover{background:color-mix(in oklab,var(--danger) 90%,transparent);}.ds-button-danger:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button-danger:disabled{cursor:not-allowed;background:var(--surface-2);color:var(--muted);outline:1px solid var(--border-strong);}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Wrapper owns field focus; the input has no duplicate ring.",
      "html": "<label class=\"ds-field\">Display name<span class=\"ds-field-wrap\"><input aria-label=\"Display name\" placeholder=\"Display name\"></span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:600 14px/20px var(--font-body);color:var(--ink)}.ds-field-wrap{display:flex;height:48px;border:1px solid var(--border-strong);border-radius:9999px;background:var(--surface-2);transition:border-color 150ms}.ds-field-wrap:focus-within{border-color:var(--ring);outline:2px solid var(--ring);outline-offset:2px;}.ds-field input{min-width:0;width:100%;padding:0 16px;border:0;border-radius:9999px;background:transparent;color:var(--ink);font:400 16px/24px var(--font-body);outline:none}.ds-field input::placeholder{color:var(--muted)}.ds-field input:disabled{cursor:not-allowed;color:var(--muted)}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Desktop active item; icons are inline SVG.",
      "html": "<nav aria-label=\"Sample primary\"><a class=\"ds-nav\" href=\"#\" aria-current=\"page\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1Z\"/></svg><span>Home</span></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 12px;border-radius:9999px;background:var(--surface-2);color:var(--ink);font:600 16px/24px var(--font-body);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav:hover{background:var(--surface-2)}.ds-nav:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Plan Badge",
      "kind": "chip",
      "refersTo": "plan-badge",
      "description": "Real plan status link, mobile target and denser desktop size.",
      "html": "<a class=\"ds-badge\" href=\"#\">Free</a>",
      "css": ".ds-badge{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;border:1px solid var(--border-strong);border-radius:9999px;color:var(--ink);font:600 12px/16px var(--font-body);text-decoration:none;transition:background-color 150ms}.ds-badge:hover{background:var(--surface-2)}.ds-badge:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}@media(min-width:768px){.ds-badge{min-height:28px;padding:0 10px}}"
    },
    {
      "name": "Shell Panel",
      "kind": "card",
      "refersTo": "shell-panel",
      "description": "Opaque graduated shared shell material; sample padding comes from the right rail.",
      "html": "<section class=\"ds-panel\"><h2>About Tether</h2><p>A calm place for public conversations.</p></section>",
      "css": ".ds-panel{padding:20px;border-radius:20px;background-color:var(--surface);background-image:linear-gradient(145deg,var(--panel-highlight),var(--surface) 48%,var(--panel-low));box-shadow:inset 0 1px 0 rgb(255 255 255 / .06),var(--shadow);color:var(--ink);font-family:var(--font-body)}.ds-panel h2{margin:0;font-size:18px;line-height:28px;font-weight:600}.ds-panel p{margin:12px 0 0;color:var(--muted);font-size:14px;line-height:1.625}@media(min-width:768px){.ds-panel{border-radius:32px}}"
    },
    {
      "name": "Active Feed Tab",
      "kind": "nav",
      "refersTo": "feed-tab",
      "description": "Active tab treatment; behavior remains owned by the React ARIA-tabs implementation.",
      "html": "<button class=\"ds-tab\" type=\"button\">Public</button>",
      "css": ".ds-tab{position:relative;min-height:56px;padding:16px 8px;border:0;background:transparent;color:var(--ink);font:600 14px/20px var(--font-body);cursor:pointer;transition:color 150ms}.ds-tab::after{content:\"\";position:absolute;inset-inline:0;bottom:0;height:3px;border-radius:9999px;background:var(--accent-text)}.ds-tab:hover{color:var(--ink)}.ds-tab:focus-visible{background:var(--accent-soft);outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Profile Initials",
      "kind": "custom",
      "description": "Uploaded-image fallback and surface separation ring for the profile portrait.",
      "html": "<span class=\"ds-avatar-frame\"><span class=\"ds-avatar\" aria-hidden=\"true\">T</span></span>",
      "css": ".ds-avatar-frame{display:inline-flex;border-radius:9999px;background:var(--surface);box-shadow:0 0 0 5px var(--surface)}.ds-avatar{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:96px;height:96px;border-radius:9999px;background:var(--accent-soft);color:var(--accent-text);font:600 30px/36px var(--font-body)}@media(min-width:640px){.ds-avatar{width:112px;height:112px}}"
    }
  ],
  "narrative": {
    "northStar": "Floating charcoal panels",
    "overview": "Familiar social conversations inside spacious floating panels. The near-black sculpted canvas and graduated opaque charcoal support ordinary reading and sharing; the light theme translates that material into cool gray and porcelain.\n\nSoftly highlighted edges, circular portraits, white primary pills in dark mode and restrained blue links establish the approved world. Use the existing content and states, with spacious imagery when a user supplies it. The system sans is an explicit owner-approved choice for this reference-led interface.",
    "keyCharacteristics": [
      "Opaque graduated panels over a static CSS sculpted backdrop.",
      "Neutral charcoal and porcelain materials; blue for links and focus.",
      "Broad outer corners, pill controls, circular avatars and quiet separators.",
      "Three desktop panels that simplify to an icon rail and then mobile tabs."
    ],
    "rules": [
      {
        "name": "Opaque Material",
        "body": "Panels must remain readable on their opaque base; the backdrop is independent artwork, and blur is not required.",
        "section": "elevation"
      },
      {
        "name": "Neutral Action",
        "body": "Use the neutral accent pair for primary actions and the blue accent-text role for links, selection and focus.",
        "section": "colors"
      },
      {
        "name": "One Family",
        "body": "Keep headings, body copy and controls on the approved system sans stack; distinguish hierarchy through size, weight and spacing.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the semantic CSS variables so saved and system theme preferences stay coherent.",
      "Do preserve the detached shell geometry, quiet separators and opaque panel bases.",
      "Do keep visible focus, readable disabled states, safe-area padding and mobile touch targets.",
      "Do use actual uploaded imagery or the existing initials/gradient fallback; retain supplied image alt text.",
      "Do retain the collision-safe Clerk aliases and CSS-object pricing button state overrides."
    ],
    "donts": [
      "Don't replace the static backdrop with animation or introduce blur-dependent readability.",
      "Don't add invented engagement, recommendations, verification or profile tabs to fill space.",
      "Don't multiply opaque cards inside the continuous feed panel or introduce hard offset shadows.",
      "Don't treat QA screenshots as runtime image assets or add reference photography as real account content."
    ]
  }
}
